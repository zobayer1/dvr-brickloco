################################################################################
# BrickLoco — BepInEx plugin for Derail Valley
#
# This is a .NET class library that *references* Unity assemblies; it is not a Unity
# project. If a Unity asset project is ever added for authoring meshes, give it its own
# .gitignore rather than extending this one.
################################################################################

# Build output
[Bb]in/
[Oo]bj/

# IDE / editor
.vs/
.idea/
_ReSharper*/
*.[Rr]e[Ss]harper
*.user
*.suo
*.userosscache
*.sln.docstates
*.rsuser
.vscode/*
!.vscode/tasks.json

# Build intermediates
*.pdb
*.mdb
*.cache
*.log
*.tlog
*.ilk

# NuGet
packages/
**/packages/*
*.nupkg

# Test results / coverage
TestResults/
*.trx
coverage/
*.coverage
*.coveragexml

# OS junk
Thumbs.db
Desktop.ini
.DS_Store
